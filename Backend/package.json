{
  "name": "backend-v2",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:identity": "node --env-file=.env node_modules/nodemon/bin/nodemon.js --config nodemon.json",
    "identity:start": "npm --workspace @backend-v2/identity-service run start",
    "identity:test": "npm --workspace @backend-v2/identity-service run test",
    "users:test": "node services/identity-service/scripts/test-user-admin.mjs",
    "identity:migrate": "npm --workspace @backend-v2/identity-service run migrate",
    "identity:test:e2e": "node --test tests/e2e/*.test.js",
    "catalog:start": "npm --workspace @backend-v2/catalog-service run start",
    "catalog:migrate": "npm --workspace @backend-v2/catalog-service run migrate",
    "catalog:test": "npm --workspace @backend-v2/catalog-service run test",
    "stores:test": "node services/catalog-service/scripts/test-store-admin.mjs",
    "catalog:seed": "node services/catalog-service/scripts/seed.js",
    "catalog:seed:reset": "node services/catalog-service/scripts/seed.js --reset",
    "order:start": "npm --workspace @backend-v2/order-service run start",
    "order:migrate": "npm --workspace @backend-v2/order-service run migrate",
    "order:test": "npm --workspace @backend-v2/order-service run test",
    "dashboard:test": "node services/order-service/scripts/test-dashboard-queue.mjs",
    "payment:start": "npm --workspace @backend-v2/payment-service run start",
    "payment:migrate": "npm --workspace @backend-v2/payment-service run migrate",
    "payment:test": "npm --workspace @backend-v2/payment-service run test",
    "engagement:start": "npm --workspace @backend-v2/engagement-service run start",
    "engagement:migrate": "npm --workspace @backend-v2/engagement-service run migrate",
    "engagement:test": "npm --workspace @backend-v2/engagement-service run test",
    "chat:start": "npm --workspace @backend-v2/chat-service run start",
    "chat:test": "npm --workspace @backend-v2/chat-service run test"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "4.0.3"
    }
  }
}
