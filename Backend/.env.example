# Identity Service (copy required values into .env; never commit .env)
IDENTITY_DATABASE_URL=postgresql://identity:change-me@localhost:5432/identity
POSTGRES_PASSWORD=change-me
IDENTITY_JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
IDENTITY_MAIL_KEY=replace-with-base64-of-32-random-bytes
# Production requires an independent base64 key of 32 bytes. Development derives a separate key from IDENTITY_MAIL_KEY when empty.
ADMIN_MFA_KEY=
ADMIN_SESSION_SECONDS=28800
ADMIN_IDLE_SECONDS=1800
ADMIN_REAUTH_SECONDS=300
ADMIN_MFA_LIMIT=8
ADMIN_PASSKEYS_ENABLED=false
IDENTITY_PORT=5101
IDENTITY_CATALOG_URL=http://127.0.0.1:5102
IDENTITY_ORDER_URL=http://127.0.0.1:5103
USER_TEMP_SUSPENSION_MAX_DAYS=366
USER_SIGNAL_WINDOW_DAYS=30
USER_PRIVACY_ARTIFACT_HOURS=168
CATALOG_PORT=5102
ORDER_PORT=5103
ORDER_DATABASE_URL=postgresql://orders:change-me@localhost:5432/orders
ORDER_IDENTITY_URL=http://127.0.0.1:5101
ORDER_CATALOG_URL=http://127.0.0.1:5102
ORDER_PAYMENT_URL=http://127.0.0.1:5104
ORDER_CHAT_URL=http://127.0.0.1:5106
CATALOG_DATABASE_URL=postgresql://catalog:change-me@localhost:5432/catalog
# Local dev generator points this to the same PostgreSQL instance as Identity, with a separate schema.
# Deployment should use a dedicated Catalog database.
CATALOG_IDENTITY_URL=http://127.0.0.1:5101
CATALOG_SYNC_SECRET=replace-with-a-random-64-character-hex-secret
INVENTORY_INTERNAL_TOKEN=replace-with-an-independent-random-64-character-hex-secret
ADMIN_AUTHORIZATION_TOKEN=replace-with-an-independent-random-64-character-hex-secret
ORDER_DELIVERY_TOKEN=replace-with-another-independent-random-64-character-hex-secret
ORDER_PAYMENT_TOKEN=replace-with-another-independent-random-64-character-hex-secret
ORDER_ONLINE_METHODS=
PAYMENT_PORT=5104
PAYMENT_DATABASE_URL=postgresql://payments:change-me@localhost:5432/payments
PAYMENT_IDENTITY_URL=http://127.0.0.1:5101
PAYMENT_ORDER_URL=http://127.0.0.1:5103
PAYMENT_PUBLIC_URL=http://127.0.0.1:5104
PAYMENT_INTERNAL_TOKEN=replace-with-independent-random-64-character-hex-secret
PAYMENT_SETTLEMENT_TOKEN=replace-with-another-independent-random-64-character-hex-secret
PROMOTION_INTERNAL_TOKEN=replace-with-another-independent-random-64-character-hex-secret
PROMOTION_ADMIN_TOKEN=replace-with-a-separate-random-64-character-hex-secret
CHAT_ORDER_TOKEN=replace-with-another-independent-random-64-character-hex-secret
CHAT_PORT=5106
CHAT_ENGAGEMENT_URL=http://127.0.0.1:5105
CHAT_MONGO_USER=chatdev
CHAT_MONGO_PASSWORD=replace-with-random-hex-password
CHAT_MONGO_URL=mongodb://chatdev:replace-with-random-hex-password@127.0.0.1:27018/mduc247_chat?authSource=admin
CHAT_ATTACHMENT_SECRET=replace-with-another-independent-random-64-character-hex-secret
CHAT_PUBLIC_URL=http://127.0.0.1:5106
CHAT_RETENTION_DAYS=365
NOTIFICATION_ORDER_TOKEN=replace-with-independent-random-64-character-hex-secret
NOTIFICATION_PAYMENT_TOKEN=replace-with-independent-random-64-character-hex-secret
NOTIFICATION_CHAT_TOKEN=replace-with-independent-random-64-character-hex-secret
NOTIFICATION_IDENTITY_TOKEN=replace-with-independent-random-64-character-hex-secret
IDENTITY_EVENT_WEBHOOK_TOKEN=replace-with-independent-random-64-character-hex-secret
IDENTITY_EVENT_WEBHOOK_URL=http://127.0.0.1:5105/api/v2/internal/notifications/identity-events
NOTIFICATION_ADMIN_TOKEN=replace-with-independent-random-64-character-hex-secret
ORDER_NOTIFICATION_WEBHOOK_URL=http://127.0.0.1:5105/api/v2/internal/notifications/order-events
PAYMENT_NOTIFICATION_WEBHOOK_URL=http://127.0.0.1:5105/api/v2/internal/notifications/payment-events
CHAT_NOTIFICATION_WEBHOOK_URL=http://127.0.0.1:5105/api/v2/internal/notifications/chat-events
# Production: set CHAT_S3_BUCKET and S3 credentials; local files are development-only.
# CHAT_S3_BUCKET=chat-attachments
# Optional classifier returns an intent enum only; bot answers remain grounded in Catalog/Order.
# CHAT_INTENT_URL=
# CHAT_INTENT_TOKEN=
# Optional paid Claude proxy for nuanced shopping questions; keep the key only in server env.
# CHAT_CLAUDE_API_KEY=
# CHAT_CLAUDE_BASE_URL=https://1gw.gwai.cloud
# CHAT_CLAUDE_MODEL=claude-haiku-5-5
# CHAT_CLAUDE_MODE=selective
# CHAT_CLAUDE_MAX_TOKENS=160
# CHAT_CLAUDE_DAILY_LIMIT=20
# Optional offline notification webhook with X-Event-Id retry.
# CHAT_NOTIFICATION_WEBHOOK_URL=
# CHAT_NOTIFICATION_WEBHOOK_TOKEN=
ENGAGEMENT_PORT=5105
ENGAGEMENT_DATABASE_URL=postgresql://engagement:change-me@localhost:5432/engagement
ENGAGEMENT_IDENTITY_URL=http://127.0.0.1:5101
ENGAGEMENT_CATALOG_URL=http://127.0.0.1:5102
ENGAGEMENT_ORDER_URL=http://127.0.0.1:5103
ENGAGEMENT_PAYMENT_URL=http://127.0.0.1:5104
ENGAGEMENT_CHAT_URL=http://127.0.0.1:5106
ORDER_ENGAGEMENT_URL=http://127.0.0.1:5105
# Enable MoMo only after onboarding and configuring public HTTPS IPN/redirect URLs.
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_API_BASE_URL=https://test-payment.momo.vn
# MOMO_IPN_URL=https://your-domain/api/v2/payments/webhooks/momo
# MOMO_REDIRECT_URL=https://your-frontend/payments/return
# VietQR Payment Kit requires a verified webhook, never just an image-generation key.
# VIETQR_CLIENT_ID=
# VIETQR_API_KEY=
# VIETQR_WEBHOOK_TOKEN=
# VIETQR_API_BASE_URL=https://api.vietqr.io
# Optional outbox webhook; receiver deduplicates X-Event-Id.
# ORDER_EVENT_WEBHOOK_URL=https://delivery-adapter.example.com/internal/order-events
# ORDER_EVENT_WEBHOOK_TOKEN=replace-with-independent-secret
# Optional inventory outbox delivery; receiver must deduplicate X-Event-Id.
# INVENTORY_EVENT_WEBHOOK_URL=https://orders.example.com/internal/inventory-events
# INVENTORY_EVENT_WEBHOOK_TOKEN=replace-with-independent-secret
FRONTEND_ORIGIN=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=true
REFRESH_DAYS=30
LOGIN_LIMIT=5
# Set only when the service is reachable exclusively through this trusted proxy.
# TRUSTED_PROXY_IP=127.0.0.1
# Resend SMTP: verify mduc247.site in Resend before sending from this address.
# For local Mailpit, use localhost/identity-mail, port 1025, secure=false.
SMTP_HOST=smtp.resend.com
SMTP_HOST_DOCKER=smtp.resend.com
SMTP_PORT=465
SMTP_PORT_DOCKER=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=replace-with-resend-api-key
MAIL_FROM=no-reply@mduc247.site
# Avatar storage and malware scanner (required for avatar upload)
S3_BUCKET=identity-avatars
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9002
S3_ENDPOINT_DOCKER=http://identity-objects:9000
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=local-avatar-user
S3_SECRET_KEY=change-this-local-storage-password
S3_AUTO_CREATE_BUCKET=true
CLAMAV_HOST=127.0.0.1
CLAMAV_HOST_DOCKER=identity-scanner
CLAMAV_PORT=3311
CLAMAV_PORT_DOCKER=3310
# Send the OTP for adding/changing a phone to the account email.
PHONE_OTP_MODE=email
# Optional future SMS provider mode (required to verify ownership of the phone).
# SMS_WEBHOOK_URL=https://your-sms-adapter.example/send
# SMS_WEBHOOK_TOKEN=replace-me

# New stores only; existing stores retain NOT_REQUIRED unless explicitly migrated.
STORE_APPROVAL_REQUIRED=false
# Requires separate request/approval permissions and independent verified tickets.
STORE_OWNERSHIP_ENABLED=false
CATALOG_ORDER_URL=http://127.0.0.1:5103
CATALOG_ENGAGEMENT_URL=http://127.0.0.1:5105
CATALOG_CHAT_URL=http://127.0.0.1:5106
